{
  "$schema": "../manifest.schema.json",
  "name": "news-agent",
  "displayName": "뉴스 담당 AI",
  "description": "방송·통신 산업과 경쟁사(Sagemcom, Vantiva, CommScope, SDMC, Strong/Skyworth, ZTE 등) 뉴스의 수집·분류·요약을 담당한다. 기간·주제별 뉴스 검색과 브리핑, 월간 시장동향 Trend Report 초안, 유관부서 뉴스레터 초안을 처리한다. 자사 웹사이트 트래픽 수치나 인사 관련 질문은 담당하지 않는다.",
  "version": "1.0.0",
  "owner": {
    "team": "마케팅팀",
    "contact": "marketing-news@kaon.com"
  },
  "endpoint": {
    "url": "https://news-agent.kaon.internal/mcp",
    "protocol": "mcp",
    "auth": "service-token"
  },
  "permissions": {
    "allowedGroups": [],
    "handlesPersonalData": false,
    "dataSources": ["산업 전문 매체 RSS 피드", "경쟁사 홈페이지/Press Release", "LinkedIn 채널", "공용 DB news 스키마"]
  },
  "tools": [
    {
      "name": "search_news",
      "description": "수집된 뉴스를 키워드·분류·기업·기간으로 검색한다. '이번 주 경쟁사 소식 뭐 있어?' 류의 질문에 사용.",
      "input": {
        "type": "object",
        "properties": {
          "query": { "type": "string" },
          "category": { "type": "string", "enum": ["competitor", "industry", "linkedin", "all"], "default": "all" },
          "product": { "type": "string", "enum": ["video", "broadband", "all"], "default": "all" },
          "company": { "type": "string" },
          "period": { "type": "string", "description": "예: 2026-06-01..2026-06-30" },
          "limit": { "type": "integer", "default": 20, "maximum": 100 }
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "articles": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string" },
                "source": { "type": "string" },
                "url": { "type": "string", "format": "uri" },
                "publishedAt": { "type": "string", "format": "date" },
                "category": { "type": "string" },
                "companies": { "type": "array", "items": { "type": "string" } },
                "summary": { "type": "string" }
              }
            }
          },
          "totalCount": { "type": "integer" }
        }
      }
    },
    {
      "name": "summarize_period",
      "description": "특정 기간의 주요 뉴스를 주제별로 묶어 요약 브리핑을 생성한다. 다른 Agent에 업계 컨텍스트를 제공할 때도 사용된다.",
      "input": {
        "type": "object",
        "required": ["period"],
        "properties": {
          "period": { "type": "string" },
          "topic": { "type": "string", "description": "선택. 특정 주제로 좁힐 때" }
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "summary": { "type": "string" },
          "keyArticles": { "type": "array", "items": { "type": "string", "format": "uri" } }
        }
      }
    },
    {
      "name": "draft_trend_report",
      "description": "월간 시장동향 Trend Report 초안을 생성한다. 과거 리포트의 구성·문체를 따른다. 결과는 초안이며 담당자 검수가 필요하다.",
      "input": {
        "type": "object",
        "required": ["month"],
        "properties": { "month": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" } }
      },
      "output": {
        "type": "object",
        "properties": {
          "draftUrl": { "type": "string", "format": "uri" },
          "highlights": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    {
      "name": "draft_digest_mail",
      "description": "유관부서에 보낼 주요 뉴스 요약 메일 초안을 작성한다. 발송은 하지 않는다 — 담당자가 승인 후 발송.",
      "requiresApproval": true,
      "input": {
        "type": "object",
        "required": ["period", "recipients"],
        "properties": {
          "period": { "type": "string" },
          "recipients": { "type": "array", "items": { "type": "string", "format": "email" } }
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "draftId": { "type": "string" },
          "subject": { "type": "string" },
          "body": { "type": "string" },
          "approvalUrl": { "type": "string", "format": "uri", "description": "담당자가 검토·발송하는 화면 링크" }
        }
      }
    }
  ],
  "events": [
    {
      "name": "news.important",
      "description": "경쟁사 중대 발표(CEO 교체, M&A, 대형 수주 등) 감지 시 발행. 3줄 요약 포함.",
      "defaultChannels": ["teams"]
    }
  ],
  "jobs": [
    {
      "name": "rss_ingest",
      "schedule": "0 * * * *",
      "description": "매시 정각: RSS 피드 수집 → URL 해시·유사도 기반 중복 제거 → 신규 기사 분류·태깅"
    },
    {
      "name": "weekly_digest_prepare",
      "schedule": "0 9 * * 1",
      "description": "매주 월요일 09시: 지난주 주요 뉴스 다이제스트 초안 생성 → 담당자에게 검수 요청"
    }
  ]
}
