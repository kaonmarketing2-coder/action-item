{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kaon.internal/schemas/agent-manifest/v1",
  "title": "KAON Agent Manifest",
  "description": "모든 도메인 Agent가 제출하는 '인사기록카드'. 오케스트레이터(통합 안내데스크)는 이 파일만 읽고 Agent를 자동 등록한다.",
  "type": "object",
  "required": ["name", "displayName", "description", "version", "owner", "endpoint", "tools"],
  "additionalProperties": false,
  "properties": {

    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,30}$",
      "description": "시스템 내부용 고유 ID (영문 소문자·숫자·하이픈). 예: traffic-agent"
    },

    "displayName": {
      "type": "string",
      "maxLength": 40,
      "description": "사용자에게 보여줄 이름. 예: 트래픽 담당 AI"
    },

    "description": {
      "type": "string",
      "minLength": 30,
      "maxLength": 500,
      "description": "가장 중요한 항목. 오케스트레이터가 '어떤 질문을 이 Agent에게 보낼지' 판단하는 근거가 되는 자기소개. 담당 업무 범위와 담당하지 않는 것까지 구체적으로 쓴다."
    },

    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "매니페스트 버전 (semver). 도구 추가/변경 시 올린다."
    },

    "owner": {
      "type": "object",
      "required": ["team", "contact"],
      "additionalProperties": false,
      "properties": {
        "team": { "type": "string", "description": "담당 팀. 예: 마케팅팀" },
        "contact": { "type": "string", "format": "email", "description": "장애·문의 연락처" }
      }
    },

    "endpoint": {
      "type": "object",
      "required": ["url", "protocol"],
      "additionalProperties": false,
      "description": "오케스트레이터가 이 Agent를 호출하는 주소",
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "protocol": { "const": "mcp", "description": "도구 호출 표준. 현재 MCP로 고정" },
        "auth": {
          "type": "string",
          "enum": ["service-token", "none"],
          "default": "service-token"
        }
      }
    },

    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "description": "누가 쓸 수 있고, 어떤 데이터를 다루는지",
      "properties": {
        "allowedGroups": {
          "type": "array",
          "items": { "type": "string" },
          "description": "이 Agent를 호출할 수 있는 사용자 그룹 (SSO 그룹명). 비우면 전 임직원",
          "default": []
        },
        "handlesPersonalData": {
          "type": "boolean",
          "default": false,
          "description": "true면 개인정보 취급 Agent. 오케스트레이터에는 요약·집계만 반환해야 하며 권한 심사 대상"
        },
        "dataSources": {
          "type": "array",
          "items": { "type": "string" },
          "description": "접근하는 외부 시스템·데이터 목록 (감사용). 예: GA4, MS Graph"
        }
      }
    },

    "tools": {
      "type": "array",
      "minItems": 1,
      "description": "오케스트레이터가 호출할 수 있는 기능 목록 = '부탁하면 하는 일'",
      "items": {
        "type": "object",
        "required": ["name", "description", "input", "output"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,40}$",
            "description": "도구 ID (snake_case). 예: get_traffic_summary"
          },
          "description": {
            "type": "string",
            "minLength": 20,
            "description": "언제 이 도구를 써야 하는지 오케스트레이터가 읽는 설명"
          },
          "input": {
            "type": "object",
            "description": "입력값 정의 (JSON Schema). '주문서 양식'에 해당"
          },
          "output": {
            "type": "object",
            "description": "반환값 정의 (JSON Schema). 반환 형식이 고정되어야 조합 가능"
          },
          "requiresApproval": {
            "type": "boolean",
            "default": false,
            "description": "true면 실행 전 사람 승인 필수 (메일 발송, 지급 등 외부로 나가는 행동)"
          }
        }
      }
    },

    "events": {
      "type": "array",
      "description": "이 Agent가 먼저 알리는 알림 목록 = '먼저 말 거는 일'. 알림 라우터가 구독",
      "default": [],
      "items": {
        "type": "object",
        "required": ["name", "description"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9_]*$",
            "description": "이벤트 ID: '<agent>.<event>' 형식. 예: traffic.anomaly"
          },
          "description": { "type": "string" },
          "defaultChannels": {
            "type": "array",
            "items": { "type": "string", "enum": ["teams", "email"] },
            "default": ["teams"]
          }
        }
      }
    },

    "jobs": {
      "type": "array",
      "description": "정해진 때에 알아서 하는 반복 작업 목록 (문서화 목적 — 실행은 공용 스케줄러가 담당)",
      "default": [],
      "items": {
        "type": "object",
        "required": ["name", "schedule", "description"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "schedule": { "type": "string", "description": "cron 표현식. 예: '0 6 1 * *' = 매월 1일 06시" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
